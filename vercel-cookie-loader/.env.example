# Main native login flow. Use your own deployment and separate random secrets.
BROWSERBASE_API_KEY=replace_me
BROWSERBASE_PROJECT_ID=replace_me
COOKIE_INGEST_SECRET=replace_with_at_least_32_random_characters
APP_TRANSFER_SECRET=replace_with_a_separate_random_secret
COOKIE_DOMAIN_ALLOWLIST=ycombinator.com
PUBLIC_BASE_URL=https://your-project.vercel.app

# Match Config/Local.xcconfig. Required only for App Clip website association.
APPLE_TEAM_ID=YOURTEAMID
APP_BUNDLE_IDENTIFIER=com.yourcompany.CookieClipDemo

# Optional browser clients.
# ALLOWED_ORIGIN=https://your-frontend.example

# Optional legacy SMS experiment; not part of the current native sign-in flow.
# TEXT_SEND_SECRET=replace_with_a_separate_random_secret
# HANDOFF_SECRET=replace_with_a_separate_random_secret
# TARGET_DOMAIN_ALLOWLIST=ycombinator.com
# TWILIO_ACCOUNT_SID=replace_me
# TWILIO_API_KEY_SID=replace_me
# TWILIO_API_KEY_SECRET=replace_me
# TWILIO_MESSAGING_SERVICE_SID=replace_me
# TWILIO_AUTH_TOKEN=replace_me
# SMS_BRAND_NAME=Cookie Clip
# SMS_PROVIDER=textbelt
# TEXTBELT_API_KEY=replace_me
