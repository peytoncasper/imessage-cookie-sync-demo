# Main native login flow. Use your own deployment and separate random secrets.
BROWSERBASE_API_KEY=replace_me
BROWSERBASE_PROJECT_ID=replace_me
COOKIE_INGEST_SECRET=replace_with_at_least_32_random_characters
APP_TRANSFER_SECRET=replace_with_a_separate_random_secret
